APP_ENV=dev
DATABASE_URL=sqlite:///./media_library.db
MEDIA_OUTPUT_DIR=./media_optimized
THUMBNAIL_DIR=./media_thumbs
WATCHER_POLL_SECONDS=4
FILE_STABLE_SECONDS=8
JOB_WORKERS=2
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
MAX_FEED_PAGE_SIZE=50
DEFAULT_FEED_PAGE_SIZE=15
TRANSCODE_MAX_WIDTH=1920
TRANSCODE_MAX_HEIGHT=1080
TRANSCODE_COMPATIBLE_BITRATE_LIMIT=7500000
TRANSCODE_VIDEO_MAXRATE=4500k
TRANSCODE_VIDEO_BUFSIZE=9000k
TRANSCODE_AUDIO_BITRATE=128k
TRANSCODE_PRESET=superfast
TRANSCODE_CRF=22
TRANSCODE_THREADS=0
DELETE_SOURCE_AFTER_TRANSCODE=true
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=media-library-backend/1.0 by u/local
REDDIT_TIMEOUT_SECONDS=25
REDDIT_DOWNLOAD_DIR=./reddit_downloads
