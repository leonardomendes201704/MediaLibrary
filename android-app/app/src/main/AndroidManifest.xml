<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".MediaLibraryApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaLibrary"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.onboarding.ProviderGateActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaLibrary" />
        <activity
            android:name=".ui.onboarding.CategoryPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaLibrary" />
        <activity
            android:name=".ui.config.ServerConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaLibrary" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:theme="@style/Theme.MediaLibrary">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
